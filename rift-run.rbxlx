    <Item class="Folder" referent="11">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">CombatService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CompanionConfig = require(ReplicatedStorage.Shared.Config.CompanionConfig)
local CombatService = {}
local lastAttack = {}
local dataService
local runService
local enemyService
local remotes
local ATTACK_COOLDOWN = 0.65
local ATTACK_RANGE = 18

function CombatService:Start(dependencies)
    dataService = dependencies.PlayerDataService
    runService = dependencies.RunService
    enemyService = dependencies.EnemyService
    remotes = dependencies.Remotes
    remotes.Attack.OnServerEvent:Connect(function(player)
        local now = os.clock()
        if now - (lastAttack[player] or 0) < ATTACK_COOLDOWN then return end
        lastAttack[player] = now
        local run = runService:Get(player)
        local data = dataService:Get(player)
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local enemy = enemyService:GetCurrent(player)
        if not run or not data or not root or not enemy or not enemy.PrimaryPart then return end
        if (root.Position - enemy.PrimaryPart.Position).Magnitude > ATTACK_RANGE then return end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then return end
        local companionBonus = 0
        for _, id in data.Companions.Equipped do
            local companion = CompanionConfig[id]
            if companion then companionBonus += companion.DamageBonus end
        end
        local upgradeLevel = data.Upgrades.Power or 0
        local damage = math.floor(12 * (1 + upgradeLevel * 0.08 + companionBonus) + 0.5)
        enemyService:Damage(player, damage)
        remotes.Hit:FireClient(player, { Damage = damage })
    end)
    game:GetService("Players").PlayerRemoving:Connect(function(player) lastAttack[player] = nil end)
end

return CombatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">DataTemplate</string>
          <string name="Source"><![CDATA[return {
    SchemaVersion = 1,
    Level = 1,
    XP = 0,
    Essence = 0,
    BestZone = "Grasslands",
    Upgrades = { Power = 0 },
    Companions = { Owned = { "Sproutling" }, Equipped = { "Sproutling" } },
    FirstClear = {},
    Settings = { Music = 1, Effects = 1 },
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">EconomyService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CompanionConfig = require(ReplicatedStorage.Shared.Config.CompanionConfig)
local EconomyService = {}
local dataService
local remotes

local function xpToNext(level)
    return math.floor(60 * (level ^ 1.35) + 0.5)
end

function EconomyService:Start(dependencies)
    dataService = dependencies.PlayerDataService
    remotes = dependencies.Remotes
end

function EconomyService:AwardEnemy(player, config)
    local data = dataService:Get(player)
    if not data then return end
    local essenceBonus = 0
    for _, companionId in data.Companions.Equipped do
        local companion = CompanionConfig[companionId]
        if companion then essenceBonus += companion.EssenceBonus end
    end
    local firstBossClear = config.Boss and not data.FirstClear.Grasslands
    local essence = math.floor(config.Essence * (1 + essenceBonus) + 0.5)
    if firstBossClear then essence += 100 end
    data.Essence += essence
    data.XP += config.XP
    while data.XP >= xpToNext(data.Level) do
        data.XP -= xpToNext(data.Level)
        data.Level += 1
    end
    dataService:UpdateAttributes(player)
    remotes.Reward:FireClient(player, { Essence = essence, XP = config.XP, Level = data.Level, TotalEssence = data.Essence, TotalXP = data.XP, XPToNext = xpToNext(data.Level) })
end

function EconomyService:XPToNext(level)
    return xpToNext(level)
end

return EconomyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">EnemyService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local EnemyConfig = require(ReplicatedStorage.Shared.Config.EnemyConfig)
local EnemyService = {}
local current = {}
local runService
local economy
local remotes

local function makeEnemy(lane, id, index)
    local config = EnemyConfig[id]
    local model = Instance.new("Model")
    model.Name = id
    model:SetAttribute("EnemyId", id)
    model:SetAttribute("Health", config.Health)
    model:SetAttribute("MaxHealth", config.Health)
    model:SetAttribute("EnemyIndex", index)
    model:SetAttribute("IsBoss", config.Boss)
    local body = Instance.new("Part")
    body.Name = "Body"
    body.Shape = config.Boss and Enum.PartType.Ball or Enum.PartType.Block
    body.Size = config.Boss and Vector3.new(10, 10, 10) or Vector3.new(5, 5, 5)
    body.Position = Vector3.new(lane.X, config.Boss and 5 or 3, 30)
    body.Anchored = true
    body.Material = config.Boss and Enum.Material.Neon or Enum.Material.SmoothPlastic
    body.Color = config.Boss and Color3.fromRGB(100, 230, 150) or Color3.fromRGB(113, 181, 116)
    body.Parent = model
    model.PrimaryPart = body
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "EnemyBillboard"
    billboard.Size = UDim2.fromOffset(180, 54)
    billboard.StudsOffset = Vector3.new(0, config.Boss and 7 or 4, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = body
    local label = Instance.new("TextLabel")
    label.Name = "NameLabel"
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextStrokeTransparency = 0.25
    label.Font = Enum.Font.GothamBold
    label.TextScaled = true
    label.Text = config.Name .. "  " .. config.Health .. "/" .. config.Health
    label.Parent = billboard
    model.Parent = lane.Folder
    return model
end

function EnemyService:Start(dependencies)
    runService = dependencies.RunService
    economy = dependencies.EconomyService
    remotes = dependencies.Remotes
end

function EnemyService:SpawnFor(player)
    self:Clear(player)
    local run = runService:Get(player)
    if not run then return end
    local zone = require(ReplicatedStorage.Shared.Config.ZoneConfig).Grasslands
    local id = zone.EnemyIds[run.Index]
    local model = makeEnemy(run.Lane, id, run.Index)
    current[player] = model
    remotes.Enemy:FireClient(player, { Name = EnemyConfig[id].Name, Health = EnemyConfig[id].Health, MaxHealth = EnemyConfig[id].Health, IsBoss = EnemyConfig[id].Boss })
end

function EnemyService:GetCurrent(player)
    return current[player]
end

function EnemyService:Damage(player, amount)
    local model = current[player]
    if not model or not model.Parent or not model.PrimaryPart then return false end
    local health = model:GetAttribute("Health")
    health = math.max(0, health - amount)
    model:SetAttribute("Health", health)
    local id = model:GetAttribute("EnemyId")
    local config = EnemyConfig[id]
    local label = model.PrimaryPart:FindFirstChild("EnemyBillboard") and model.PrimaryPart.EnemyBillboard:FindFirstChild("NameLabel")
    if label then label.Text = config.Name .. "  " .. health .. "/" .. config.Health end
    remotes.Enemy:FireClient(player, { Name = config.Name, Health = health, MaxHealth = config.Health, IsBoss = config.Boss })
    if health <= 0 then
        current[player] = nil
        model:Destroy()
        economy:AwardEnemy(player, config)
        task.delay(0.8, function() if player.Parent then runService:Advance(player) end end)
    end
    return true
end

function EnemyService:Clear(player)
    local model = current[player]
    current[player] = nil
    if model then model:Destroy() end
end

return EnemyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[local Workspace = game:GetService("Workspace")
local MapBuilder = {}
local root
local lanes = {}
local baseSlots = {}
local PORTALS = {
    { Id = "Grasslands_Easy", Label = "Grasslands • Easy", Color = Color3.fromRGB(90, 235, 145), Difficulty = "Easy", Offset = -20 },
    { Id = "Grasslands_Normal", Label = "Grasslands • Normal", Color = Color3.fromRGB(255, 211, 79), Difficulty = "Normal", Offset = 0 },
    { Id = "Grasslands_Hard", Label = "Grasslands • Hard", Color = Color3.fromRGB(255, 112, 89), Difficulty = "Hard", Offset = 20 },
}
local function part(parent, name, size, cframe, color, material)
    local item = Instance.new("Part")
    item.Name, item.Size, item.CFrame = name, size, cframe
    item.Anchored = true
    item.Color = color
    item.Material = material or Enum.Material.SmoothPlastic
    item.TopSurface = Enum.SurfaceType.Smooth
    item.BottomSurface = Enum.SurfaceType.Smooth
    item.Parent = parent
    return item
end
local function prompt(parent, name, action, object)
    local p = Instance.new("ProximityPrompt")
    p.Name, p.ActionText, p.ObjectText = name, action, object
    p.HoldDuration = 0
    p.MaxActivationDistance = 12
    p.RequiresLineOfSight = false
    p.Parent = parent
    return p
end
local function makeBase(slot)
    local angle = math.rad((slot - 1) * 60 - 90)
    local x, z = math.cos(angle) * 47, math.sin(angle) * 47
    local base = Instance.new("Folder")
    base.Name = string.format("PlayerBase_%02d", slot)
    base:SetAttribute("BaseSlot", slot)
    base.Parent = root.Hub
    part(base, "BaseFloor", Vector3.new(30, 1, 24), CFrame.new(x, 0, z), Color3.fromRGB(105, 91, 75), Enum.Material.WoodPlanks)
    part(base, "BaseSign", Vector3.new(12, 5, 1), CFrame.new(x, 4, z - 11), Color3.fromRGB(64, 52, 45), Enum.Material.Wood)
    local sign = Instance.new("BillboardGui")
    sign.Size, sign.StudsOffset, sign.AlwaysOnTop = UDim2.fromOffset(180, 48), Vector3.new(0, 3, 0), true
    sign.Parent = base.BaseSign
    local text = Instance.new("TextLabel")
    text.Size, text.BackgroundTransparency = UDim2.fromScale(1, 1), 1
    text.Text, text.TextColor3, text.TextScaled = "PLAYER BASE " .. slot, Color3.new(1,1,1), true
    text.Font = Enum.Font.GothamBold
    text.Parent = sign
    local stations = { "Blacksmith", "Pet Carer", "Armorer", "Enchanter", "Skill Master" }
    for i, name in stations do
        local sx = x - 11 + ((i - 1) % 3) * 11
        local sz = z + 3 + math.floor((i - 1) / 3) * 8
        local station = part(base, string.gsub(name, " ", "") .. "Station", Vector3.new(7, 4, 6), CFrame.new(sx, 2.5, sz), Color3.fromRGB(113, 133, 148), Enum.Material.Slate)
        station:SetAttribute("StationType", name)
        prompt(station, "Open" .. string.gsub(name, " ", ""), "Open", name)
    end
    baseSlots[slot] = base
end
function MapBuilder:Start()
    root = Workspace:FindFirstChild("RiftRunWorld") or Instance.new("Folder")
    root.Name = "RiftRunWorld"
    root:ClearAllChildren()
    root.Parent = Workspace
    local hub = Instance.new("Folder")
    hub.Name, hub.Parent = "Hub", root
    part(hub, "SharedHubFloor", Vector3.new(150, 2, 150), CFrame.new(0, -1, 0), Color3.fromRGB(78,109,93), Enum.Material.Grass)
    part(hub, "CentralPlaza", Vector3.new(55, 1, 45), CFrame.new(0, 0, 0), Color3.fromRGB(119,111,103), Enum.Material.Cobblestone)
    part(hub, "CorridorFloor", Vector3.new(34, 1, 125), CFrame.new(0, 0, -118), Color3.fromRGB(93,98,98), Enum.Material.Slate)
    part(hub, "CorridorLeftWall", Vector3.new(2, 12, 125), CFrame.new(-18, 6, -118), Color3.fromRGB(68,81,86), Enum.Material.Slate)
    part(hub, "CorridorRightWall", Vector3.new(2, 12, 125), CFrame.new(18, 6, -118), Color3.fromRGB(68,81,86), Enum.Material.Slate)
    for _, portalInfo in PORTALS do
        local x = portalInfo.Offset
        local door = part(hub, portalInfo.Id, Vector3.new(9, 12, 2), CFrame.new(x, 6, -62), portalInfo.Color, Enum.Material.Neon)
        door:SetAttribute("ZoneId", "Grasslands")
        door:SetAttribute("Difficulty", portalInfo.Difficulty)
        prompt(door, "Enter" .. portalInfo.Difficulty, "Enter", portalInfo.Label)
    end
    for slot = 1, 6 do makeBase(slot) end
    local spawn = part(hub, "HubSpawn", Vector3.new(6,1,6), CFrame.new(0,1,18), Color3.fromRGB(230,218,170), Enum.Material.Sand)
    spawn.Transparency, spawn.CanCollide = 1, false
    Workspace:SetAttribute("RiftRunWorldReady", true)
end
function MapBuilder:GetHubSpawnCFrame() return CFrame.new(0, 4, 18) end
function MapBuilder:GetPortalPrompts()
    local prompts = {}
    for _, info in PORTALS do
        local door = root.Hub:FindFirstChild(info.Id)
        if door then table.insert(prompts, { Prompt = door:FindFirstChildWhichIsA("ProximityPrompt"), Difficulty = info.Difficulty }) end
    end
    return prompts
end
function MapBuilder:AssignBase(player)
    for slot = 1, 6 do
        if baseSlots[slot] and not baseSlots[slot]:GetAttribute("OwnerUserId") then
            baseSlots[slot]:SetAttribute("OwnerUserId", player.UserId)
            baseSlots[slot].Name = "PlayerBase_" .. player.UserId
            return slot
        end
    end
    return nil
end
function MapBuilder:ReleaseBase(player)
    for slot = 1, 6 do
        local base = baseSlots[slot]
        if base and base:GetAttribute("OwnerUserId") == player.UserId then
            base:SetAttribute("OwnerUserId", nil)
            base.Name = string.format("PlayerBase_%02d", slot)
            return
        end
    end
end
function MapBuilder:CreateLane(player)
    if lanes[player] then return lanes[player] end
    local slot = tonumber(player:GetAttribute("BaseSlot")) or 1
    local x = 2400 + slot * 240
    local folder = Instance.new("Folder")
    folder.Name, folder.Parent = "Run_" .. player.UserId, root
    folder:SetAttribute("OwnerUserId", player.UserId)
    part(folder, "LaneFloor", Vector3.new(45,2,130), CFrame.new(x,-1,0), Color3.fromRGB(81,125,91), Enum.Material.Grass)
    part(folder, "LeftBoundary", Vector3.new(2,18,130), CFrame.new(x-23,8,0), Color3.fromRGB(87,105,99), Enum.Material.Slate)
    part(folder, "RightBoundary", Vector3.new(2,18,130), CFrame.new(x+23,8,0), Color3.fromRGB(87,105,99), Enum.Material.Slate)
    local returnPortal = part(folder, "ReturnPortal", Vector3.new(8,12,1), CFrame.new(x,7,53), Color3.fromRGB(97,206,255), Enum.Material.Neon)
    local lane = { Folder = folder, X = x, ReturnPrompt = prompt(returnPortal,"Return","Return","Shared Hub") }
    lanes[player] = lane
    return lane
end
function MapBuilder:RemoveLane(player)
    local lane = lanes[player]
    if lane then lane.Folder:Destroy(); lanes[player] = nil end
end
function MapBuilder:LaneFor(player) return lanes[player] end
return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">PlayerDataService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local Template = require(script.Parent.DataTemplate)

local PlayerDataService = {}
local profiles = {}
local readyEvent = Instance.new("BindableEvent")
PlayerDataService.Ready = readyEvent.Event

local function mergeDefaults(target, defaults)
    for key, value in pairs(defaults) do
        if target[key] == nil then
            target[key] = table.clone(value)
        elseif type(value) == "table" and type(target[key]) == "table" then
            mergeDefaults(target[key], value)
        end
    end
end

function PlayerDataService:Get(player)
    local profile = profiles[player]
    if profile and profile:IsActive() then
        return profile.Data
    end
    return nil
end

function PlayerDataService:IsReady(player)
    return self:Get(player) ~= nil
end

function PlayerDataService:UpdateAttributes(player)
    local data = self:Get(player)
    if not data then return end
    player:SetAttribute("Essence", data.Essence)
    player:SetAttribute("Level", data.Level)
    player:SetAttribute("XP", data.XP)
end

function PlayerDataService:Start()
    local packageFolder = ServerScriptService:FindFirstChild("Packages")
    local profileModule = packageFolder and packageFolder:FindFirstChild("ProfileStore")
    assert(profileModule, "Missing ServerScriptService.Packages.ProfileStore. Follow TRANSFER-TO-STUDIO.md.")
    local ProfileStore = require(profileModule)
    local store = ProfileStore.New("RiftRun_PlayerData_v1", Template)

    local function loadPlayer(player)
        local profile = store:StartSessionAsync("Player_" .. player.UserId, {
            Cancel = function() return player.Parent ~= Players end,
        })
        if not profile then
            if player.Parent == Players then
                player:Kick("Your data could not be loaded. Please rejoin in a moment.")
            end
            return
        end
        profile:AddUserId(player.UserId)
        profile:Reconcile()
        mergeDefaults(profile.Data, Template)
        profiles[player] = profile
        profile.OnSessionEnd:Connect(function()
            profiles[player] = nil
            if player.Parent == Players then
                player:Kick("Your data session ended. Please rejoin.")
            end
        end)
        if player.Parent ~= Players then
            profiles[player] = nil
            profile:EndSession()
            return
        end
        self:UpdateAttributes(player)
        readyEvent:Fire(player)
    end

    Players.PlayerAdded:Connect(loadPlayer)
    for _, player in Players:GetPlayers() do task.spawn(loadPlayer, player) end
    Players.PlayerRemoving:Connect(function(player)
        local profile = profiles[player]
        profiles[player] = nil
        if profile then profile:EndSession() end
    end)
    game:BindToClose(function()
        for player, profile in pairs(profiles) do
            profiles[player] = nil
            profile:EndSession()
        end
    end)
end

return PlayerDataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Remotes = {}

function Remotes.Create()
    local folder = ReplicatedStorage:FindFirstChild("RiftRunRemotes") or Instance.new("Folder")
    folder.Name = "RiftRunRemotes"
    folder.Parent = ReplicatedStorage
    local result = { Folder = folder }
    for _, name in { "Attack", "Upgrade" } do
        local remote = folder:FindFirstChild(name) or Instance.new("RemoteEvent")
        remote.Name = name
        remote.Parent = folder
        result[name] = remote
    end
    for _, name in { "State", "Enemy", "Reward", "Hit", "Message" } do
        local remote = folder:FindFirstChild(name) or Instance.new("RemoteEvent")
        remote.Name = name
        remote.Parent = folder
        result[name] = remote
    end
    return result
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">RunService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = {}
local active = {}
local worldFolder
local remotes
local maps
local dataService
local enemies

function RunService:Start(dependencies)
    dataService = dependencies.PlayerDataService
    maps = dependencies.MapBuilder
    enemies = dependencies.EnemyService
    remotes = dependencies.Remotes
    worldFolder = workspace:WaitForChild("RiftRunWorld")
    for _, entry in maps:GetPortalPrompts() do\n        entry.Prompt.Triggered:Connect(function(player) self:Enter(player, entry.Difficulty) end)\n    end
    dataService.Ready:Connect(function(player)
        player:LoadCharacter()
        task.defer(function()
            local character = player.Character
            local rootPart = character and character:WaitForChild("HumanoidRootPart", 5)
            if rootPart then rootPart.CFrame = maps:GetHubSpawnCFrame() end
        end)
    end)
    game:GetService("Players").PlayerRemoving:Connect(function(player) self:Exit(player, true); maps:ReleaseBase(player) end)
end

function RunService:Enter(player, difficulty)
    if not dataService:IsReady(player) or active[player] then return end
    local lane = maps:CreateLane(player)
    active[player] = { Lane = lane, Index = 1, Difficulty = difficulty or "Normal", RunId = tostring(player.UserId) .. "-" .. tostring(os.time()) }
    lane.ReturnPrompt.Triggered:Connect(function(triggeringPlayer)
        if triggeringPlayer == player then self:Exit(player, false) end
    end)
    local character = player.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if rootPart then rootPart.CFrame = CFrame.new(lane.X, 4, 45) end
    remotes.State:FireClient(player, { InRun = true, Zone = "Grasslands", EnemyIndex = 1 })
    enemies:SpawnFor(player)
end

function RunService:Get(player)
    return active[player]
end

function RunService:Advance(player)
    local run = active[player]
    if not run then return end
    run.Index += 1
    if run.Index > 6 then
        local data = dataService:Get(player)
        if data then
            data.FirstClear.Grasslands = true
            data.BestZone = "Grasslands"
        end
        remotes.State:FireClient(player, { InRun = true, Complete = true, Zone = "Grasslands" })
        task.delay(3, function() self:Exit(player, false) end)
        return
    end
    remotes.State:FireClient(player, { InRun = true, Zone = "Grasslands", EnemyIndex = run.Index })
    enemies:SpawnFor(player)
end

function RunService:Exit(player, removeLane)
    local run = active[player]
    if not run then return end
    active[player] = nil
    enemies:Clear(player)
    if not removeLane then
        local rootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if rootPart then rootPart.CFrame = maps:GetHubSpawnCFrame() end
        remotes.State:FireClient(player, { InRun = false, Zone = "Grasslands" })
    end
    maps:RemoveLane(player)
end

return RunService

]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">UpgradeService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UpgradeConfig = require(ReplicatedStorage.Shared.Config.UpgradeConfig)
local UpgradeService = {}
local dataService
local remotes

function UpgradeService:Start(dependencies)
    dataService = dependencies.PlayerDataService
    remotes = dependencies.Remotes
    remotes.Upgrade.OnServerEvent:Connect(function(player, upgradeId)
        if upgradeId ~= "Power" then return end
        local data = dataService:Get(player)
        if not data then return end
        local config = UpgradeConfig.Power
        local level = data.Upgrades.Power or 0
        if level >= config.MaxLevel then return end
        local cost = math.floor(config.BaseCost * (config.CostMultiplier ^ level) + 0.5)
        if data.Essence < cost then
            remotes.Message:FireClient(player, "Not enough Essence")
            return
        end
        data.Essence -= cost
        data.Upgrades.Power = level + 1
        dataService:UpdateAttributes(player)
        remotes.Message:FireClient(player, "Power upgraded to " .. tostring(level + 1))
    end)
end

return UpgradeService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="21">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="22">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="23">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("RiftRunRemotes")
local attackRemote = remotes:WaitForChild("Attack")
local upgradeRemote = remotes:WaitForChild("Upgrade")
local stateRemote = remotes:WaitForChild("State")
local enemyRemote = remotes:WaitForChild("Enemy")
local rewardRemote = remotes:WaitForChild("Reward")
local hitRemote = remotes:WaitForChild("Hit")
local messageRemote = remotes:WaitForChild("Message")

local gui = Instance.new("ScreenGui")
gui.Name = "RiftRunHUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.Parent = player:WaitForChild("PlayerGui")

local function label(name, text, size, position, color)
    local item = Instance.new("TextLabel")
    item.Name = name
    item.Size = size
    item.Position = position
    item.BackgroundColor3 = Color3.fromRGB(35, 43, 52)
    item.BackgroundTransparency = 0.12
    item.TextColor3 = color or Color3.new(1, 1, 1)
    item.Font = Enum.Font.GothamBold
    item.TextScaled = true
    item.Text = text
    item.Parent = gui
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = item
    return item
end

local stats = label("Stats", "Loading profile...", UDim2.fromOffset(290, 72), UDim2.new(0, 18, 0, 18), Color3.fromRGB(255, 238, 166))
local zone = label("Zone", "SHARED HUB", UDim2.fromOffset(220, 48), UDim2.new(0.5, -110, 0, 18), Color3.fromRGB(190, 255, 218))
local enemyLabel = label("Enemy", "Walk to the Grasslands portal", UDim2.fromOffset(320, 50), UDim2.new(0.5, -160, 0, 78), Color3.new(1, 1, 1))
local attackButton = Instance.new("TextButton")
attackButton.Name = "AttackButton"
attackButton.Size = UDim2.fromOffset(150, 74)
attackButton.Position = UDim2.new(1, -174, 1, -104)
attackButton.BackgroundColor3 = Color3.fromRGB(71, 190, 133)
attackButton.TextColor3 = Color3.new(1, 1, 1)
attackButton.Text = "ATTACK"
attackButton.TextScaled = true
attackButton.Font = Enum.Font.GothamBlack
attackButton.Parent = gui
Instance.new("UICorner", attackButton).CornerRadius = UDim.new(0, 18)
local upgradeButton = Instance.new("TextButton")
upgradeButton.Name = "UpgradeButton"
upgradeButton.Size = UDim2.fromOffset(170, 52)
upgradeButton.Position = UDim2.new(0, 18, 1, -72)
upgradeButton.BackgroundColor3 = Color3.fromRGB(239, 174, 68)
upgradeButton.TextColor3 = Color3.fromRGB(44, 40, 34)
upgradeButton.Text = "POWER UPGRADE"
upgradeButton.TextScaled = true
upgradeButton.Font = Enum.Font.GothamBold
upgradeButton.Parent = gui
Instance.new("UICorner", upgradeButton).CornerRadius = UDim.new(0, 14)
local toast = label("Toast", "", UDim2.fromOffset(320, 42), UDim2.new(0.5, -160, 1, -58), Color3.fromRGB(255, 237, 176))
toast.Visible = false

local function refreshStats()
    stats.Text = string.format("Essence  %d\nLevel  %d  •  XP  %d", player:GetAttribute("Essence") or 0, player:GetAttribute("Level") or 1, player:GetAttribute("XP") or 0)
end
player:GetAttributeChangedSignal("Essence"):Connect(refreshStats)
player:GetAttributeChangedSignal("Level"):Connect(refreshStats)
player:GetAttributeChangedSignal("XP"):Connect(refreshStats)
refreshStats()

local function attack()
    attackRemote:FireServer()
end
attackButton.Activated:Connect(attack)
upgradeButton.Activated:Connect(function() upgradeRemote:FireServer("Power") end)
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.F or input.UserInputType == Enum.UserInputType.MouseButton1 then attack() end
end)

stateRemote.OnClientEvent:Connect(function(payload)
    if payload.Complete then
        zone.Text = "GRASSLANDS CLEARED!"
        enemyLabel.Text = "Returning to the hub..."
    elseif payload.InRun then
        zone.Text = "GRASSLANDS  •  " .. tostring(payload.EnemyIndex or "BOSS") .. "/6"
        enemyLabel.Text = "Approach the enemy and attack"
    else
        zone.Text = "SHARED HUB"
        enemyLabel.Text = "Walk to the Grasslands portal"
    end
end)
enemyRemote.OnClientEvent:Connect(function(payload)
    enemyLabel.Text = string.format("%s  •  %d / %d HP", payload.Name, payload.Health, payload.MaxHealth)
end)
rewardRemote.OnClientEvent:Connect(function(payload)
    toast.Text = string.format("+%d Essence   +%d XP", payload.Essence, payload.XP)
    toast.Visible = true
    task.delay(2, function() toast.Visible = false end)
    refreshStats()
end)
hitRemote.OnClientEvent:Connect(function(payload)
    enemyLabel.Text = enemyLabel.Text .. string.format("   (-%d)", payload.Damage)
end)
messageRemote.OnClientEvent:Connect(function(message)
    toast.Text = tostring(message)
    toast.Visible = true
    task.delay(2, function() toast.Visible = false end)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="24">
        <Properties>
          <string name="Name">Controllers</string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="25">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>